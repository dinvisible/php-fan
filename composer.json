{
  "name": "php-fan/php-fan-5",
  "description": "PHP-FAN framework",
  "license": "LGPL-3.0-or-later",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "illuminate/database": "^12.0",
    "monolog/monolog": "^3.0",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "fan\\core\\adapter\\": [
        "core/adapter/",
        "core/factory/adapter/"
      ],
      "fan\\core\\bootstrap\\": [
        "core/application/",
        "core/factory/"
      ],
      "fan\\core\\di\\": [
        "core/di/",
        "core/factory/"
      ],
      "fan\\core\\runtime\\": [
        "core/runtime/",
        "core/factory/runtime/"
      ],
      "fan\\core\\": "core/",
      "fan\\project\\": "project/",
      "fan\\app\\": "project/app/"
    },
    "files": [
      "core/functions.php",
      "tools/composer_autoload.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "FanTest\\": "unit/mock/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "ai:map": "php tools/ai_map.php --json",
    "ai:verify": "php tools/ai_verify.php",
    "ai:verify:changed": "php tools/ai_verify.php --changed",
    "ai:static": "php tools/ai_static_check.php"
  }
}
