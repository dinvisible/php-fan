{
  "name": "php-fan/php-fan-5",
  "description": "PHP-FAN framework",
  "license": "LGPL-3.0-or-later",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "illuminate/database": "^12.0",
    "monolog/monolog": "^3.0",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "fan\\core\\adapter\\": [
        "_core/adapter/",
        "_core/factory/adapter/"
      ],
      "fan\\core\\bootstrap\\": [
        "_core/application/",
        "_core/factory/"
      ],
      "fan\\core\\di\\": [
        "_core/di/",
        "_core/factory/"
      ],
      "fan\\core\\runtime\\": [
        "_core/runtime/",
        "_core/factory/runtime/"
      ],
      "fan\\core\\": "_core/",
      "fan\\project\\": "_project/",
      "fan\\app\\": "_project/app/"
    },
    "files": [
      "_core/functions.php",
      "tools/composer_autoload.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "FanTest\\": "unit/mock/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  }
}
