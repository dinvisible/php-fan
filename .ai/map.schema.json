{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://php-fan.local/schemas/ai-map.schema.json",
  "title": "PHP-FAN AI map",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "entrypoints",
    "source_roots",
    "test_roots",
    "autoload",
    "ai_docs",
    "commands",
    "counts",
    "files",
    "services",
    "metadata",
    "dynamic_boundaries",
    "source_inventory",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_roots": {
      "$ref": "#/$defs/stringList"
    },
    "test_roots": {
      "$ref": "#/$defs/stringList"
    },
    "autoload": {
      "type": "object",
      "required": [
        "psr-4",
        "files",
        "dev_psr-4"
      ],
      "additionalProperties": true
    },
    "ai_docs": {
      "$ref": "#/$defs/stringList"
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "files": {
      "type": "object",
      "required": [
        "meta",
        "templates"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/stringList"
        },
        "templates": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "required": [
        "registered",
        "aliases",
        "referenced",
        "referenced_locations",
        "constants",
        "descriptors"
      ],
      "properties": {
        "registered": {
          "$ref": "#/$defs/occurrenceMap"
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "target",
              "file",
              "line"
            ],
            "properties": {
              "target": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "referenced": {
          "$ref": "#/$defs/occurrenceMap"
        },
        "referenced_locations": {
          "$ref": "#/$defs/sourceLocationOccurrenceMap"
        },
        "constants": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "descriptors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/serviceDescriptor"
          }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": [
        "meta_schema",
        "meta",
        "templates"
      ],
      "properties": {
        "meta_schema": {
          "const": ".ai/meta.schema.json"
        },
        "meta": {
          "$ref": "#/$defs/metaMetadata"
        },
        "templates": {
          "$ref": "#/$defs/templateMetadata"
        }
      },
      "additionalProperties": false
    },
    "dynamic_boundaries": {
      "type": "object",
      "required": [
        "categories",
        "category_reasons",
        "locations",
        "composition_leaf_policy",
        "terminal_composition_leaves",
        "actionable_composition_roots",
        "named_migration_debt_policy",
        "actionable_named_migration_debt",
        "intentional_named_compatibility_boundaries"
      ],
      "properties": {
        "categories": {
          "$ref": "#/$defs/dynamicBoundaryCategories"
        },
        "category_reasons": {
          "$ref": "#/$defs/dynamicBoundaryCategoryReasons"
        },
        "locations": {
          "$ref": "#/$defs/dynamicBoundaryLocations"
        },
        "composition_leaf_policy": {
          "$ref": "#/$defs/dynamicBoundaryCompositionLeafPolicy"
        },
        "terminal_composition_leaves": {
          "$ref": "#/$defs/stringList"
        },
        "actionable_composition_roots": {
          "$ref": "#/$defs/stringList"
        },
        "named_migration_debt_policy": {
          "$ref": "#/$defs/dynamicBoundaryNamedMigrationDebtPolicy"
        },
        "actionable_named_migration_debt": {
          "$ref": "#/$defs/dynamicBoundaryNamedDebtSummaryList"
        },
        "intentional_named_compatibility_boundaries": {
          "$ref": "#/$defs/dynamicBoundaryNamedDebtSummaryList"
        }
      },
      "additionalProperties": true
    },
    "source_inventory": {
      "$ref": "#/$defs/sourceInventory"
    },
    "verification": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "occurrenceMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/stringList"
      }
    },
    "sourceLocationOccurrenceMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sourceLocationList"
      }
    },
    "dynamicBoundaryCategories": {
      "type": "object",
      "required": [
        "extension_api",
        "composition_roots",
        "tooling_support",
        "migration_debt"
      ],
      "properties": {
        "extension_api": {
          "$ref": "#/$defs/stringList"
        },
        "composition_roots": {
          "$ref": "#/$defs/stringList"
        },
        "tooling_support": {
          "$ref": "#/$defs/stringList"
        },
        "migration_debt": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "dynamicBoundaryCategoryReasons": {
      "type": "object",
      "required": [
        "extension_api",
        "composition_roots",
        "tooling_support",
        "migration_debt"
      ],
      "properties": {
        "extension_api": {
          "type": "string",
          "minLength": 1
        },
        "composition_roots": {
          "type": "string",
          "minLength": 1
        },
        "tooling_support": {
          "type": "string",
          "minLength": 1
        },
        "migration_debt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dynamicBoundaryLocations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dynamicBoundaryLocationList"
      }
    },
    "dynamicBoundaryCompositionLeafPolicy": {
      "type": "object",
      "required": [
        "terminal_count",
        "actionable_min_count",
        "terminal_kind",
        "actionable_kind",
        "description"
      ],
      "properties": {
        "terminal_count": {
          "const": 1
        },
        "actionable_min_count": {
          "const": 2
        },
        "terminal_kind": {
          "const": "terminal_composition_leaf"
        },
        "actionable_kind": {
          "const": "actionable_composition_root"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dynamicBoundaryNamedMigrationDebtPolicy": {
      "type": "object",
      "required": [
        "boundary_kind",
        "category",
        "actionable_kind",
        "intentional_kind",
        "description"
      ],
      "properties": {
        "boundary_kind": {
          "const": "named_default_closure_boundary"
        },
        "category": {
          "const": "migration_debt"
        },
        "actionable_kind": {
          "const": "actionable_named_migration_debt"
        },
        "intentional_kind": {
          "const": "intentional_named_compatibility_boundary"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dynamicBoundaryNamedDebtSummaryList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dynamicBoundaryNamedDebtSummary"
      }
    },
    "dynamicBoundaryNamedDebtSummary": {
      "type": "object",
      "required": [
        "file",
        "category",
        "boundary_kind",
        "named_debt_kind",
        "reason",
        "count",
        "patterns",
        "locations"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "extension_api",
            "migration_debt"
          ]
        },
        "boundary_kind": {
          "const": "named_default_closure_boundary"
        },
        "named_debt_kind": {
          "enum": [
            "actionable_named_migration_debt",
            "intentional_named_compatibility_boundary"
          ]
        },
        "reason": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "patterns": {
          "$ref": "#/$defs/stringList"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dynamicBoundaryNamedDebtLocation"
          }
        }
      },
      "additionalProperties": false
    },
    "dynamicBoundaryNamedDebtLocation": {
      "type": "object",
      "required": [
        "file",
        "line",
        "pattern",
        "value",
        "boundary_kind",
        "named_debt_kind"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "boundary_kind": {
          "const": "named_default_closure_boundary"
        },
        "named_debt_kind": {
          "enum": [
            "actionable_named_migration_debt",
            "intentional_named_compatibility_boundary"
          ]
        }
      },
      "additionalProperties": false
    },
    "sourceInventory": {
      "type": "object",
      "required": [
        "policy",
        "queues",
        "next"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/sourceInventoryPolicy"
        },
        "queues": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sourceInventoryQueue"
          }
        },
        "next": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceInventoryQueue"
          }
        }
      },
      "additionalProperties": false
    },
    "sourceInventoryPolicy": {
      "type": "object",
      "required": [
        "description",
        "classification_kinds",
        "next_queue"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "classification_kinds": {
          "$ref": "#/$defs/stringList"
        },
        "next_queue": {
          "const": "source_inventory.next"
        }
      },
      "additionalProperties": false
    },
    "sourceInventoryQueue": {
      "type": "object",
      "required": [
        "id",
        "guard_kind",
        "classification",
        "priority",
        "reason",
        "count",
        "files",
        "locations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "guard_kind": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "$ref": "#/$defs/stringList"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceInventoryLocation"
          }
        }
      },
      "additionalProperties": false
    },
    "sourceInventoryLocation": {
      "type": "object",
      "required": [
        "file",
        "line",
        "pattern",
        "value"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dynamicBoundaryLocationList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dynamicBoundaryLocation"
      }
    },
    "dynamicBoundaryLocation": {
      "type": "object",
      "required": [
        "file",
        "line",
        "pattern",
        "value",
        "boundary_kind"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "boundary_kind": {
          "enum": [
            "method_body_or_runtime_boundary",
            "named_default_closure_boundary"
          ]
        }
      },
      "additionalProperties": false
    },
    "serviceDescriptor": {
      "type": "object",
      "required": [
        "id",
        "registrar_files",
        "creator_methods",
        "shared",
        "dependencies",
        "factory_origin",
        "factory_arguments",
        "creator_method_arguments",
        "aliases",
        "referenced_by",
        "class",
        "factory",
        "config_key",
        "lifetime_reason",
        "source_edges",
        "source_locations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "registrar_files": {
          "$ref": "#/$defs/stringList"
        },
        "creator_methods": {
          "$ref": "#/$defs/stringList"
        },
        "shared": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "dependencies": {
          "$ref": "#/$defs/stringList"
        },
        "factory_origin": {
          "type": "object",
          "required": [
            "registrar_files",
            "creator_methods"
          ],
          "properties": {
            "registrar_files": {
              "$ref": "#/$defs/stringList"
            },
            "creator_methods": {
              "$ref": "#/$defs/stringList"
            }
          },
          "additionalProperties": false
        },
        "factory_arguments": {
          "type": "object",
          "required": [
            "container_dependencies",
            "runtime_arguments"
          ],
          "properties": {
            "container_dependencies": {
              "$ref": "#/$defs/stringList"
            },
            "runtime_arguments": {
              "$ref": "#/$defs/stringList"
            }
          },
          "additionalProperties": false
        },
        "creator_method_arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/creatorMethodArgumentDescriptor"
          }
        },
        "aliases": {
          "$ref": "#/$defs/stringList"
        },
        "referenced_by": {
          "$ref": "#/$defs/serviceReferenceSummary"
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        },
        "factory": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifetime_reason": {
          "type": "string",
          "minLength": 1
        },
        "source_edges": {
          "$ref": "#/$defs/sourceEdges"
        },
        "source_locations": {
          "$ref": "#/$defs/sourceLocations"
        }
      },
      "additionalProperties": false
    },
    "sourceEdges": {
      "type": "object",
      "required": [
        "aliases",
        "classes",
        "dependencies",
        "factories",
        "config_keys",
        "runtime_arguments",
        "registrar_files",
        "creator_methods"
      ],
      "properties": {
        "aliases": {
          "$ref": "#/$defs/stringList"
        },
        "classes": {
          "$ref": "#/$defs/stringList"
        },
        "dependencies": {
          "$ref": "#/$defs/stringList"
        },
        "factories": {
          "$ref": "#/$defs/stringList"
        },
        "config_keys": {
          "$ref": "#/$defs/stringList"
        },
        "runtime_arguments": {
          "$ref": "#/$defs/stringList"
        },
        "registrar_files": {
          "$ref": "#/$defs/stringList"
        },
        "creator_methods": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "serviceReferenceSummary": {
      "type": "object",
      "required": [
        "files",
        "locations"
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/stringList"
        },
        "locations": {
          "$ref": "#/$defs/sourceLocationList"
        }
      },
      "additionalProperties": false
    },
    "sourceLocations": {
      "type": "object",
      "required": [
        "registrations",
        "creator_methods",
        "classes",
        "factories",
        "config_keys",
        "dependencies",
        "runtime_arguments",
        "aliases"
      ],
      "properties": {
        "registrations": {
          "$ref": "#/$defs/sourceLocationList"
        },
        "creator_methods": {
          "$ref": "#/$defs/sourceLocationList"
        },
        "classes": {
          "$ref": "#/$defs/sourceLocationList"
        },
        "dependencies": {
          "$ref": "#/$defs/sourceLocationList"
        },
        "factories": {
          "$ref": "#/$defs/sourceLocationList"
        },
        "config_keys": {
          "$ref": "#/$defs/sourceLocationList"
        },
        "runtime_arguments": {
          "$ref": "#/$defs/sourceLocationList"
        },
        "aliases": {
          "$ref": "#/$defs/sourceLocationList"
        }
      },
      "additionalProperties": false
    },
    "sourceLocationList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceLocation"
      }
    },
    "sourceLocation": {
      "type": "object",
      "required": [
        "file",
        "line"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "creatorMethodArgumentDescriptor": {
      "type": "object",
      "required": [
        "parameters",
        "runtime_arguments",
        "container_dependencies",
        "optional_arguments"
      ],
      "properties": {
        "parameters": {
          "$ref": "#/$defs/stringList"
        },
        "runtime_arguments": {
          "$ref": "#/$defs/stringList"
        },
        "container_dependencies": {
          "$ref": "#/$defs/stringList"
        },
        "optional_arguments": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "metaMetadata": {
      "type": "object",
      "required": [
        "files",
        "top_level_key_usage",
        "own_key_usage",
        "common_key_usage"
      ],
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/metaFileEntry"
          }
        },
        "top_level_key_usage": {
          "$ref": "#/$defs/usageMap"
        },
        "own_key_usage": {
          "$ref": "#/$defs/usageMap"
        },
        "common_key_usage": {
          "$ref": "#/$defs/usageMap"
        }
      },
      "additionalProperties": false
    },
    "metaFileEntry": {
      "type": "object",
      "required": [
        "top_level_keys",
        "own_keys",
        "common_keys",
        "paired_template"
      ],
      "properties": {
        "top_level_keys": {
          "$ref": "#/$defs/stringList"
        },
        "own_keys": {
          "$ref": "#/$defs/stringList"
        },
        "common_keys": {
          "$ref": "#/$defs/stringList"
        },
        "paired_template": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "templateMetadata": {
      "type": "object",
      "required": [
        "files",
        "placeholder_usage"
      ],
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/templateFileEntry"
          }
        },
        "placeholder_usage": {
          "$ref": "#/$defs/usageMap"
        }
      },
      "additionalProperties": false
    },
    "templateFileEntry": {
      "type": "object",
      "required": [
        "placeholders",
        "paired_meta"
      ],
      "properties": {
        "placeholders": {
          "$ref": "#/$defs/stringList"
        },
        "paired_meta": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "usageMap": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
